{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/iso-certificate/layout,_N_T_/iso-certificate/page,_N_T_/iso-certificate"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/iso-certificate/__PAGE__",
    "/iso-certificate",
    "/_index",
    "/_head"
  ]
}
0:{"rsc":["$","$1","c",{"children":[[["$","title",null,{"children":"Understanding Boiler Circulation Pumps (BCP) in Thermal Power Plants — DEI VOX India"}],["$","meta",null,{"name":"description","content":"BCPs are high-pressure, wet-motor centrifugal pumps essential for forced-circulation boilers. Let's delve into their operational principles, casing designs, and mechanical failure modes."}],["$","div",null,{"className":"bg-[#F5F5F5] selection:bg-accent selection:text-black","children":[["$","div",null,{"className":"bg-black pt-40 pb-20 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.03] industrial-grid pointer-events-none"}],["$","div",null,{"className":"absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px] pointer-events-none"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"flex items-center gap-3 mb-12","children":[["$","$1","/",{"children":[false,["$","$L2",null,{"href":"/","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Home"}]]}],["$","$1","/blog",{"children":[["$","$L3",null,{"iconNode":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]],"className":"lucide-chevron-right text-white/20","size":14}],["$","$L2",null,{"href":"/blog","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Blog"}]]}],["$","$1","Understanding Boiler Circulation Pumps (BCP) in Thermal Power Plants",{"children":[["$","$L3",null,{"iconNode":"$0:rsc:props:children:0:2:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:iconNode","className":"lucide-chevron-right text-white/20","size":14}],["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-wider text-accent","children":"Understanding Boiler Circulation Pumps 
25:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"Applications of Industrial Submersible Pumps"}]
26:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-6","children":[["$","li",null,{"children":"Power plant cooling water intake sumps and condensate systems"}],["$","li",null,{"children":"Industrial process water supply from open sumps and reservoirs"}],["$","li",null,{"children":"Mine and tunnel dewatering in construction and mining industries"}],["$","li",null,{"children":"Municipal water supply and sewage pumping"}],["$","li",null,{"children":"Agricultural deep borehole irrigation"}],["$","li",null,{"children":"Offshore platform and marine bilge pumping"}],["$","li",null,{"children":"Emergency flood water removal from basements and industrial pits"}]]}]
27:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"Common Failure Modes in Submersible Pumps"}]
28:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Mechanical Seal Failure"}]
29:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Mechanical shaft seals are the most frequent failure point in oil-filled submersible motors. Seal face wear, spring fatigue, or secondary seal (O-ring) degradation allows water to enter the motor housing, leading to rapid winding insulation failure. DEI VOX replaces seals with equivalent or upgraded seal face material pairings (silicon carbide, tungsten carbide, carbon) to match the specific fluid and duty conditions."}]
2a:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Winding Insulation Failure"}]
2b:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Motor winding insulation degrades over time due to thermal cycling, moisture ingress, and voltage transients. DEI VOX performs complete stator rewinding using new insulation materials rated to the motor's original class (typically F or H), verified by insulation resistance, hi-pot, and surge comparison testing."}]
2c:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Bearing Failure"}]
2d:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Radial and thrust bearings in submersible motors are subject to accelerated wear when abrasive particles are present in the pumped fluid, or when the pump operates at low flow rates (low-flow cavitation). DEI VOX replaces bearings with OEM-equivalent or superior-specification units and addresses root causes such as worn impellers that increase hydraulic radial loads."}]
2e:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Impeller Wear and Cavitation Damage"}]
2f:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"High-velocity flow and sand abrasion erode impeller vane profiles, reducing pump head and efficiency. Cavitation — vapour bubble collapse on impeller surfaces — causes pitting damage that accelerates wear and generates severe vibration. DEI VOX restores impeller geometry using hard-facing and precision grinding, or manufactures replacement impellers where damage is beyond economic repair."}]
30:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"DEI VOX Submersible Pump Services"}]
31:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Complete Overhaul"}]
32:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Full strip-down, component inspection, and restoration of pump and motor to original or improved specification. Includes impeller, wear ring, bearing, seal, and winding assessment with component replacement as required."}]
33:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Pump Upgrading"}]
34:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"When plant conditions change — flow demand increases, head requirements are revised, or energy efficiency targets are imposed — DEI VOX engineers assess and execute submersible pump upgrades. This may include hydraulic re-rating, impeller replacement with a modified design, motor power upgrade, or conversion to improved seal technology."}]
35:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Motor Rewinding"}]
36:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Rewinding is often the most cost-effective intervention when motor winding insulation has failed. DEI VOX completes rewinds using certified magnet wire and insulation systems, with final testing to IEC 60034 standards."}]
37:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-5 mb-2","children":"Spare Parts & Reverse Engineering"}]
38:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"For older submersible pump models where OEM spare parts are unavailable, DEI VOX produces precision-dimensioned replacement components through reverse engineering — from impellers and wear rings to bearing housings and seal carriers."}]
39:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"Maintenance Best Practices for Submersible Pumps"}]
3a:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-6","children":[["$","li",null,{"children":"Periodic insulation resistance checks without removing the pump from service"}],["$","li",null,{"children":"Monitoring motor current draw for gradual increases indicating hydraulic or mechanical issues"}],["$","li",null,{"children":"Vibration analysis at pump column flange (for accessible installations)"}],["$","li",null,{"children":"Oil sampling (oil-filled motors) to detect water ingress before winding damage occurs"}],["$","li",null,{"children":"Scheduled annual or biannual pulling and inspection for critical-duty units"}],["$","li",null,{"children":"Plant water quality control to reduce abrasive and scale-forming tendencies"}]]}]
3b:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"Why Choose DEI VOX for Submersible Pump Repair"}]
3c:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-4","children":[["$","li",null,{"children":"ISO 9001:2015, 14001:2015 & 45001:2018 certified service quality"}],["$","li",null,{"children":"In-house motor rewinding, machining, and hydraulic testing facilities"}],["$","li",null,{"children":"Multi-OEM repair experience — Grundfos, KSB, Xylem, Kirloskar, BHEL and others"}],["$","li",null,{"children":"Reverse engineering for discontinued and hard-to-source components"}],["$","li",null,{"children":"24/7 emergency mobilisation across India"}],["$","li",null,{"children":"Transparent condition reporting with photographic documentation at each repair stage"}]]}]

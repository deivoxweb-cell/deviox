10:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-6","children":[["$","li",null,{"children":"NTPC and state utility sub-critical thermal power stations (200–800 MW units)"}],["$","li",null,{"children":"Supercritical boiler units in newer NTPC and private sector plants"}],["$","li",null,{"children":"CCGT plants using heat-recovery steam generators"}],["$","li",null,{"children":"Captive power: Steel plants, cement kilns, chemical and petrochemical facilities"}],["$","li",null,{"children":"Co-generation in paper, textile, and sugar industries"}],["$","li",null,{"children":"Process steam generation in refineries and fertiliser plants"}]]}]

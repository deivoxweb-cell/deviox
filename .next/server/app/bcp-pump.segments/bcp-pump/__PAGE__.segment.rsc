13:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Our standard overhaul procedure covers complete pump and motor strip-down, dimensional inspection of all rotating and static components, impeller and wear ring reconditioning to OEM dimension limits, bearing replacement, can liner inspection and fabrication, stator rewinding where required, and hydraulic performance verification on a calibrated test rig before despatch."}]
14:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-6 mb-2","children":"In-Situ BCP Casing Repair"}]
15:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"BCP casings that develop leaks at joint faces can frequently be repaired with the casing remaining connected to boiler piping. DEI VOX's in-situ machining team uses portable precision equipment to resurface flange faces and restore sealing surfaces to specification. This dramatically reduces outage time compared to full casing removal and return to workshop."}]
16:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-6 mb-2","children":"Motor Rewinding for Canned BCPs"}]
17:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Rewinding of canned motor BCP stators requires high-temperature insulation systems rated for continuous immersion in hot pressurised water. DEI VOX uses only certified insulation materials and verifies each rewind with IEC-standard electrical testing, including insulation resistance, dielectric strength (hi-pot), and partial discharge measurement."}]
18:["$","h3",null,{"className":"text-base font-semibold text-primary uppercase tracking-wide mt-6 mb-2","children":"Reverse Engineering & BCP Spare Parts"}]
19:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"A significant portion of India's installed BCP fleet consists of older imported units for which OEM support has been discontinued. DEI VOX's reverse engineering capability addresses this challenge: we measure, model, and manufacture replacement impellers, wear rings, can liners, bearing housings, and other components from appropriate base materials to defined dimensional and material specifications."}]
1a:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"BCP Maintenance & Reliability Engineering"}]
1b:["$","p",null,{"className":"text-foreground/80 text-sm font-medium leading-relaxed mb-4","children":"Improving BCP availability requires a structured reliability programme, not reactive maintenance. DEI VOX works with plant maintenance teams to develop:"}]
1c:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-4","children":[["$","li",null,{"children":"Condition monitoring protocols (vibration, temperature, motor current signature)"}],["$","li",null,{"children":"Criticality-ranked overhaul schedules aligned with planned plant outages"}],["$","li",null,{"children":"Minimum spares holding lists to support rapid turnaround during emergencies"}],["$","li",null,{"children":"Failure mode and effect analysis (FMEA) to prioritise maintenance interventions"}],["$","li",null,{"children":"Post-overhaul performance benchmarking to track hydraulic efficiency trends"}]]}]
1d:["$","h2",null,{"className":"text-xl md:text-2xl font-semibold text-primary uppercase tracking-tight mt-10 mb-3","children":"Why Clients Choose DEI VOX for BCP Work"}]
1e:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-4","children":[["$","li",null,{"children":"India's dedicated BCP specialist — this is our primary engineering focus"}],["$","li",null,{"children":"ISO 9001:2015, 14001:2015 & 45001:2018 certified operations"}],["$","li",null,{"children":"In-house machining, winding shop, and performance test facilities"}],["$","li",null,{"children":"24/7 emergency response with mobilisation to any Indian power plant"}],["$","li",null,{"children":"Multi-OEM BCP repair experience across KSB, Sulzer, Weir, BHEL, and others"}],["$","li",null,{"children":"Reverse engineering capability for discontinued and obsolete BCP models"}]]}]

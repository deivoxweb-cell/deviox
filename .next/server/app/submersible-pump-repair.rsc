14:T75b,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"Submersible Pump Repair, Upgrading & Motor Rewinding","provider":{"@type":"Organization","name":"DEI VOX","url":"https://deivoxbcp.com"},"serviceType":"Submersible Pump Motor Service","areaServed":"India","description":"Complete repair, upgrading, and motor rewinding services for industrial submersible pumping motor units. ISO 9001:2015 certified. Pan-India service coverage.","url":"https://deivoxbcp.com/submersible-pump-repair"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What types of submersible pumps does DEI VOX repair?","acceptedAnswer":{"@type":"Answer","text":"DEI VOX repairs and overhauls industrial submersible pumping motor units used in dewatering, process water supply, cooling water intake, condensate extraction, and boiler/turbine auxiliary systems. We work on units from all major manufacturers and can reverse-engineer obsolete components."}},{"@type":"Question","name":"Can submersible pump motors be rewound economically?","acceptedAnswer":{"@type":"Answer","text":"Yes. Motor rewinding is typically more economical than replacement for large submersible motors, especially when the pump casing and hydraulic components are in serviceable condition. DEI VOX evaluates the cost-benefit of rewinding versus replacement for each unit and provides transparent recommendations based on motor condition assessment."}},{"@type":"Question","name":"What does upgrading a submersible pump involve?","acceptedAnswer":{"@type":"Answer","text":"Submersible pump upgrading typically involves hydraulic re-rating (impeller diameter trimming or replacement to match revised duty conditions), motor power upgrade using modern winding designs, conversion to improved bearing and seal configurations, and integration of monitoring systems such as PT100 winding temperature sensors."}}]}]}7:["$","$3","c",{"children":[[["$","script",null,{"id":"submersible-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$14"}}],["$","div",null,{"className":"bg-[#F5F5F5] selection:bg-accent selection:text-black","children":[["$","div",null,{"className":"bg-black pt-40 pb-20 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.03] industrial-grid pointer-events-none"}],["$","div",null,{"className":"absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px] pointer-events-none"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"flex items-center gap-3 mb-12","children":[["$","$3","/",{"children":[false,["$","$Lc",null,{"href":"/","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Home"}]]}],["$","$3","/services",{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]],"className":"lucide-chevron-right text-white/20","size":14}],["$","$Lc",null,{"href":"/services","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Services"}]]}],["$","$3","Submersible Pump Repair",{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":"$7:props:children:0:1:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:iconNode","className":"lucide-chevron-right text-white/20","size":14}],["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-wider text-accent","children":"Submersible Pump Repair"}]]}]]}],["$","div",null,{"className":"grid grid-cols-2 md:grid-cols-4 gap-6 mb-16","children":[["$","div","Years BCP Experience",{"className":"border-l-2 border-accent/20 pl-6 py-2","children":["$L15","$L16"]}],"$L17","$L18","$L19"]}],"$L1a"]}]]}],"$L1b","$L1c","$L1d"]}]],null,"$L1e"]}]

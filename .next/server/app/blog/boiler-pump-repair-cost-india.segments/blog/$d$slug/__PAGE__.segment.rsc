7:["$","div",null,{"className":"max-w-7xl mx-auto px-4 py-32","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 gap-20","children":[["$","article",null,{"className":"lg:col-span-8 seo-prose","children":[["$","div",null,{"className":"flex items-center gap-6 text-[10px] text-black/30 font-bold uppercase tracking-wider mb-6","children":[["$","span",null,{"children":"June 12, 2026"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"6 min read"}],["$","span",null,{"children":"•"}],["$","span",null,{"className":"text-accent","children":"Planning"}]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-extrabold tracking-tighter text-black uppercase mb-6 leading-tight","children":"Boiler Pump Repair Cost in India: What Determines the Price?"}],["$","div",null,{"className":"w-20 h-2 bg-accent mb-12"}],[["$","h3","0",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Direct Answer"]}],["$","p","1",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Boiler pump repair cost in India cannot be quoted accurately from pump power or model alone. The price depends on the as-found condition, repair boundary, replacement parts, machining, winding or liner work, testing requirements, site mobilization, urgency, and documentation. A defensible quotation follows inspection and separates mandatory work from recommended reliability improvements."]}],["$","h3","2",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Main Cost Drivers"]}],["$","ul","3",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Pump type, pressure class, motor design, size, and OEM configuration."]}],["$","li","1",{"children":["Bearing, impeller, shaft, wear-ring, liner, stator, and casing condition."]}],["$","li","2",{"children":["Availability of drawings and genuine or reverse-engineered replacement parts."]}],["$","li","3",{"children":["In-situ machining versus workshop removal and transport."]}],["$","li","4",{"children":["Electrical rewind, insulation system, cable, and test requirements."]}],["$","li","5",{"children":["NDT, balancing, pressure testing, performance testing, and third-party inspection."]}],["$","li","6",{"children":["Emergency mobilization, outage duration, crane access, and site permits."]}]]}],["$","h3","4",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Inspection and Quotation Process"]}],["$","p","5",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Provide the nameplate, drawings, operating history, failure symptoms, photographs, recent vibration and electrical readings, and required completion date. A preliminary budget can then define likely scenarios. The final repair scope should follow dismantling and a joint inspection report listing as-found measurements, rejected parts, repair methods, lead times, and exclusions."]}],["$","h3","6",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Repair Options and Cost Control"]}],["$","p","7",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Compare repair with replacement using outage risk, remaining casing life, parts availability, energy performance, and future support. Cost can often be controlled by planning inspections before the outage, holding critical spares, approving material alternatives in advance, and separating immediate restoration from optional upgrades. The lowest initial quote is not necessarily the lowest lifecycle cost when testing, tolerances, or root-cause correction are omitted."]}],"$Lc","$Ld","$Le","$Lf","$L10","$L11"],"$L12"]}],"$L13"]}]}]

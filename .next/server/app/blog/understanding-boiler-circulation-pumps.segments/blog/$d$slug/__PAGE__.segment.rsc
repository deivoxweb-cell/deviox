 mx-auto px-4 py-32","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 gap-20","children":[["$","article",null,{"className":"lg:col-span-8 seo-prose","children":["$L5","$L6","$L7",["$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19"],"$L1a"]}],"$L1b"]}]}],"$L1c","$L1d"]}]],null,"$L1e"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mOGJHRmVZcGLY2DXQ8Lgi"}

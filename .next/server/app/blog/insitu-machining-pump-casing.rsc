28:["$","li","1",{"children":["",["$","strong","1",{"className":"font-extrabold text-black","children":"Single-Setup Operation:"}]," The machine can perform boring, face cutting, counterboring, and groove cutting in a single setup to ensure absolute concentricity."]}]
29:["$","li","2",{"children":["",["$","strong","1",{"className":"font-extrabold text-black","children":"Surface Finish Quality:"}]," Modern portable tools are capable of achieving surface finishes down to ",["$","strong","3",{"className":"font-extrabold text-black","children":"Ra 1.6 or Ra 0.8 micrometers"}],", matching workshop-grade tolerance levels."]}]

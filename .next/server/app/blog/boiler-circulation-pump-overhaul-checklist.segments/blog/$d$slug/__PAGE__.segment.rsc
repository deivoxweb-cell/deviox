c:["$","h3","0",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Direct Answer"]}]
d:["$","p","1",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["A reliable boiler circulation pump overhaul needs controlled inspection before dismantling, traceable dimensional and electrical measurements, documented repair decisions, clean assembly, and final verification against OEM or approved plant criteria. The checklist below is a planning guide; the pump-specific manual and approved quality plan remain controlling documents."]}]
e:["$","h3","2",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Incoming and Pre-Dismantling Checks"]}]
f:["$","ul","3",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Record nameplate, serial number, operating hours, failure history, and removal observations."]}],["$","li","1",{"children":["Photograph orientation, cable routing, fasteners, shims, and external condition."]}],["$","li","2",{"children":["Review vibration, motor current, temperature, flow, pressure, and protection-trip records."]}],["$","li","3",{"children":["Perform permitted insulation resistance, phase resistance, and continuity checks."]}],["$","li","4",{"children":["Check shaft freedom, axial movement, visible leakage, deposits, and transport damage."]}]]}]
10:["$","h3","4",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Dismantling and Inspection"]}]
11:["$","ul","5",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Mark component orientation and maintain traceability."]}],["$","li","1",{"children":["Measure running, sleeve-bearing, thrust, wear-ring, and rotor clearances."]}],["$","li","2",{"children":["Check shaft runout, journal condition, impeller erosion, and balance condition."]}],["$","li","3",{"children":["Inspect can liner using visual and suitable nondestructive examination methods."]}],["$","li","4",{"children":["Examine stator winding, leads, joints, insulation, core, and cooling passages."]}],["$","li","5",{"children":["Record all dimensions against OEM drawings or an approved engineering basis."]}]]}]
12:["$","h3","6",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Repair and Assembly Controls"]}]
13:["$","p","7",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Repair worn fits, renew bearings and seals as required, restore impeller and wear surfaces, and complete winding or liner work only to an approved procedure. Verify material certificates and component dimensions before assembly. Maintain cleanliness, use controlled tightening values, confirm rotor freedom at each assembly stage, and preserve measured final clearances."]}]
14:["$","h3","8",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Final Verification and Documentation"]}]
15:["$","ul","9",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Electrical tests appropriate to the motor design and repair scope."]}],["$","li","1",{"children":["Pressure or leak testing of repaired pressure-boundary components."]}],["$","li","2",{"children":["Rotor runout, balance, free rotation, and final clearance records."]}],["$","li","3",{"children":["Functional or performance testing where the facility and approved scope permit it."]}],["$","li","4",{"children":["Inspection report, repair photographs, measurement sheets, test certificates, and recommended operating checks."]}]]}]
16:["$","p","10",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["For a scoped overhaul plan, contact our ",["$","$L2","1",{"href":"/boiler-circulation-pump","className":"text-accent hover:text-black hover:underline font-bold transition-all","children":"boiler circulation pump repair team in India"}],"."]}]
17:["$","h3","11",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["FAQ"]}]
18:["$","h4","12",{"className":"text-base font-bold text-primary uppercase tracking-wide mt-6 mb-2","children":["How often should a BCP be overhauled?"]}]
19:["$","p","13",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Use the OEM interval, plant experience, operating hours, water chemistry, condition-monitoring trends, and outage strategy. Condition-based decisions are preferable to a generic interval."]}]
1a:["$","h4","14",{"className":"text-base font-bold text-primary uppercase tracking-wide mt-6 mb-2","children":["Which measurements should be retained after overhaul?"]}]
1b:["$","p","15",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Retain as-found and as-left dimensions, clearances, runout, electrical results, NDT reports, balance records, material traceability, and final test documentation."]}]

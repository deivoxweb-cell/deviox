1d:["$","section",null,{"className":"bg-black py-40 px-4 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.03] industrial-grid pointer-events-none"}],["$","div",null,{"className":"relative max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-16","children":[["$","div",null,{"className":"max-w-2xl","children":[["$","h3",null,{"className":"text-5xl md:text-7xl font-extrabold text-white uppercase tracking-tighter leading-[0.85] mb-8","children":["Resolve your ",["$","br",null,{}],["$","span",null,{"className":"text-accent","children":"Industrial Challenge."}]]}],["$","p",null,{"className":"text-white/30 text-lg font-medium leading-relaxed","children":"24/7 expert mobilization for thermal power plants and industrial facilities across India."}]]}],["$","div",null,{"className":"flex gap-6 flex-wrap","children":["$","$Lc",null,{"href":"/contact","className":"flex items-center gap-6 bg-black border border-white/10 text-white px-10 py-4 rounded-full group hover:bg-zinc-900 transition-all shadow-2xl","children":[["$","span",null,{"className":"text-[13px] font-semibold uppercase tracking-wider","children":"Contact Specialist"}],["$","div",null,{"className":"w-12 h-12 bg-accent rounded-full flex items-center justify-center text-black group-hover:rotate-45 transition-transform","children":["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":20}]}]]}]}]]}]]}]

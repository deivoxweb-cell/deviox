6:["$","div",null,{"className":"max-w-7xl mx-auto px-4 py-32","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 gap-20","children":[["$","article",null,{"className":"lg:col-span-8 seo-prose","children":[["$","div",null,{"className":"flex items-center gap-6 text-[10px] text-black/30 font-bold uppercase tracking-wider mb-6","children":[["$","span",null,{"children":"June 12, 2026"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"7 min read"}],["$","span",null,{"children":"•"}],["$","span",null,{"className":"text-accent","children":"Reliability"}]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-extrabold tracking-tighter text-black uppercase mb-6 leading-tight","children":"BCP Bearing Failure: Diagnosis and Prevention"}],["$","div",null,{"className":"w-20 h-2 bg-accent mb-12"}],[["$","h3","0",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Direct Answer"]}],["$","p","1",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["BCP bearing failure is commonly driven by contamination, inadequate cooling or lubrication flow, poor water chemistry, excessive thrust, misalignment, rotor imbalance, wrong clearance, or damage elsewhere in the rotating assembly. Prevention requires finding the cause of wear rather than simply installing a new bearing."]}],["$","h3","2",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Symptoms and Likely Causes"]}],["$","ul","3",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Increasing vibration, especially with load or temperature."]}],["$","li","1",{"children":["Rising bearing or motor temperature."]}],["$","li","2",{"children":["Increased axial movement or unstable rotor position."]}],["$","li","3",{"children":["Scored, polished, cracked, chipped, or unevenly worn bearing surfaces."]}],["$","li","4",{"children":["Metallic or carbon debris in strainers and cooling passages."]}],["$","li","5",{"children":["Rotor-to-liner rub marks or changing motor current."]}]]}],["$","h3","4",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Inspection and Diagnostic Process"]}],["$","p","5",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Review vibration, temperature, current, flow, differential pressure, starts, trips, and water-chemistry history. During dismantling, measure sleeve-bearing clearance, thrust float, shaft journal size, roundness, runout, and surface finish using calibrated instruments. Map wear around the bearing rather than recording only one diameter. Inspect cooling passages, filters, deposits, impeller condition, rotor balance, and liner clearance."]}],["$","p","6",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["For example, uniform increased clearance may indicate normal wear or abrasive contamination, while localized wear can suggest misalignment, shaft runout, distortion, or hydraulic loading. The applicable OEM tolerances and material combination must govern acceptance."]}],["$","h3","7",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Repair and Prevention Options"]}],["$","ul","8",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Replace damaged bearings with verified material and dimensions."]}],["$","li","1",{"children":["Restore or replace scored journals and thrust surfaces."]}],"$Lb","$Lc","$Ld","$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14"],"$L15"]}],"$L16"]}]}]

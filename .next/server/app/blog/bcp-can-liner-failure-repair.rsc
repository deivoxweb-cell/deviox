15:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"BCP Can Liner Failure and Repair\",\"description\":\"How BCP can liners fail, which tests reveal pinholes and cracks, and what must be controlled during liner repair or replacement.\",\"image\":[\"https://deivoxbcp.com/images/bcp-liner-bearing-inspection.png\"],\"datePublished\":\"2026-06-11T18:30:00.000Z\",\"dateModified\":\"2026-06-11T18:30:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"DEI VOX Mechanical and Electrical Inspection Team\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"DEI VOX INDIA PVT. LTD.\",\"url\":\"https://deivoxbcp.com\"},\"mainEntityOfPage\":\"https://deivoxbcp.com/blog/bcp-can-liner-failure-repair\"}"}}],["$","title",null,{"children":"BCP Can Liner Failure and Repair — DEI VOX India"}],["$","meta",null,{"name":"description","content":"How BCP can liners fail, which tests reveal pinholes and cracks, and what must be controlled during liner repair or replacement."}],["$","div",null,{"className":"bg-[#F5F5F5] selection:bg-accent selection:text-black","children":[["$","div",null,{"className":"bg-black pt-40 pb-20 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.03] industrial-grid pointer-events-none"}],["$","div",null,{"className":"absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px] pointer-events-none"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"flex items-center gap-3 mb-12","children":[["$","$3","/",{"children":[false,["$","$Ld",null,{"href":"/","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Home"}]]}],["$","$3","/blog",{"children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"m9 18 6-6-6
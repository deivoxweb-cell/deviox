{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/our-experience/layout,_N_T_/our-experience/page,_N_T_/our-experience"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/our-experience/__PAGE__",
    "/our-experience",
    "/_index",
    "/_head"
  ]
}
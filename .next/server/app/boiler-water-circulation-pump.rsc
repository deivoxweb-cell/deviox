35:["$","ul",null,{"className":"list-disc list-inside space-y-2 text-sm text-foreground/80 font-medium mb-6","children":[["$","li",null,{"children":"Continuous online vibration and temperature monitoring via plant DCS"}],["$","li",null,{"children":"Minor inspection (bearing clearance check, visual inspection) every 4,000–6,000 hours"}],["$","li",null,{"children":"Major overhaul every 12,000–20,000 hours or on condition"}],["$","li",null,{"children":"Water chemistry compliance measurement quarterly"}],["$","li",null,{"children":"Electrical insulation resistance testing at each plant outage"}]]}]

2:T728,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"BCP Pump Overhauling, Repair & Maintenance","provider":{"@type":"Organization","name":"DEI VOX","url":"https://deivoxbcp.com"},"serviceType":"BCP Boiler Circulation Pump Service","areaServed":"India","description":"Comprehensive BCP (Boiler Circulation Pump) overhauling, repair, motor rewinding, in-situ machining, reverse engineering and spare parts. ISO 9001:2015 certified. Pan-India service coverage.","url":"https://deivoxbcp.com/bcp-pump"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does BCP stand for in industrial engineering?","acceptedAnswer":{"@type":"Answer","text":"BCP stands for Boiler Circulation Pump. It is the high-pressure pump used in forced-circulation boiler systems to circulate water through evaporator tube circuits. BCPs are critical to boiler safety and efficiency in thermal power plants and industrial steam generation facilities."}},{"@type":"Question","name":"What is involved in a BCP pump overhaul?","acceptedAnswer":{"@type":"Answer","text":"A complete BCP overhaul involves: pump and motor strip-down; dimensional inspection of all components; impeller and wear ring restoration to OEM tolerances; bearing replacement; can liner inspection and replacement if required; motor stator rewinding and electrical testing; reassembly, alignment, and hydraulic performance testing."}},{"@type":"Question","name":"Can DEI VOX supply BCP spare parts without doing a full overhaul?","acceptedAnswer":{"@type":"Answer","text":"Yes. DEI VOX maintains a stock of common BCP spare parts and can also manufacture custom components through reverse engineering for obsolete or hard-to-source pump models. We supply impellers, wear rings, bearings, can liners, and mechanical seal components as stand-alone supply."}}]}]}0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"id":"bcp-pump-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","div",null,{"className":"bg-[#F5F5F5] selection:bg-accent selection:text-black","children":[["$","div",null,{"className":"bg-black pt-40 pb-20 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.03] industrial-grid pointer-events-none"}],["$","div",null,{"className":"absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px] pointer-events-none"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"flex items-center gap-3 mb-12","children":[["$","$1","/",{"children":[false,["$","$L3",null,{"href":"/","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Home"}]]}],["$","$1","/services",{"children":[["$","$L4",null,{"iconNode":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]],"className":"lucide-chevron-right text-white/20","size":14}],["$","$L3",null,{"href":"/services","className":"text-[11px] font-semibold uppercase tracking-wider text-white/40 hover:text-accent transition-colors","children":"Services"}]]}],["$","$1","BCP Pump",{"children":[["$","$L4",null,{"iconNode":"$0:rsc:props:children:0:1:props:children:0:props:children:2:props:children:0:props:children:1:props:children:0:props:iconNode","className":"lucide-chevron-right text-white/20","size":14}],["$","span",null,{"className":"text-[11px] font-semibold uppercase tracking-wider text-accent","children":"BCP Pump"}]]}]]}],["$","div",null,{"className":"grid grid-cols-2 md:grid-cols-4 gap-6 mb-16","children":[["$","div","Years BCP Experience",{"className":"border-l-2 border-accent/20 pl-6 py-2","children":[["$","p",null,{"className":"text-3xl font-extrabold text-white leading-none tracking-tighter","children":"10+"}],"$L5"]}],"$L6","$L7","$L8"]}],"$L9"]}]]}],"$La","$Lb","$Lc"]}]],null,"$Ld"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mOGJHRmVZcGLY2DXQ8Lgi"}

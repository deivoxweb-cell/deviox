1f:["$","div",null,{"className":"max-w-7xl mx-auto px-4 py-32","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 gap-20","children":[["$","article",null,{"className":"lg:col-span-8 seo-prose","children":[["$","div",null,{"className":"flex items-center gap-6 text-[10px] text-black/30 font-bold uppercase tracking-wider mb-6","children":[["$","span",null,{"children":"June 12, 2026"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"6 min read"}],["$","span",null,{"children":"•"}],["$","span",null,{"className":"text-accent","children":"Failure Analysis"}]]}],["$","h1",null,{"className":"text-4xl md:text-5xl font-extrabold tracking-tighter text-black uppercase mb-6 leading-tight","children":"BCP Can Liner Failure and Repair"}],["$","div",null,{"className":"w-20 h-2 bg-accent mb-12"}],[["$","h3","0",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Direct Answer"]}],["$","p","1",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["A BCP can liner can fail through corrosion, erosion, fatigue, rubbing, manufacturing defects, or damage during dismantling and assembly. Even a small pinhole can expose the stator insulation to process fluid. Repair begins with locating the defect, establishing its cause, checking surrounding material, and deciding whether an engineered local repair or complete liner replacement is appropriate."]}],["$","h3","2",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Symptoms and Likely Causes"]}],["$","ul","3",{"className":"list-disc list-inside space-y-3 text-sm text-foreground/80 font-medium my-6","children":[["$","li","0",{"children":["Falling insulation resistance or earth-fault trips after stable service."]}],["$","li","1",{"children":["Moisture or process-fluid evidence in the stator area."]}],["$","li","2",{"children":["Local rub marks caused by excessive bearing clearance or rotor contact."]}],["$","li","3",{"children":["Pinhole indications associated with corrosion, inclusions, or fatigue."]}],["$","li","4",{"children":["Distortion, cracked welds, or leakage after thermal cycling."]}]]}],["$","h3","4",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Inspection and Diagnostic Process"]}],["$","p","5",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Start with visual inspection under strong lighting and magnification. Use a suitable leak test and nondestructive examination method approved for the liner material and thickness. Dye penetrant can reveal surface-breaking flaws, while pressure-decay, vacuum, helium, or other sensitive leak methods may be selected by the repair specification. Measure liner geometry and check rotor-to-liner clearance because replacing the leak without correcting rubbing or bearing wear invites repeat failure."]}],["$","h3","6",{"className":"text-xl md:text-2xl font-bold text-primary uppercase tracking-tight mt-10 mb-4","children":["Repair Options"]}],["$","p","7",{"className":"text-foreground/80 text-sm md:text-base font-medium leading-relaxed mb-6","children":["Localized repair may be possible when the material, defect position, remaining thickness, and approved welding procedure allow it. Extensive corrosion, multiple indications, distortion, or uncertain integrity generally favors replacement. A replacement liner requires controlled material selection, forming, welding, dimensional verification, surface finish, leak testing, and electrical verification after assembly."]}],"$L22","$L23","$L24","$L25","$L26","$L27"],"$L28"]}],"$L29"]}]}]
